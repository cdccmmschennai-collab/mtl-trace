# MTL Trace — files that stay local.
# No project data goes to the remote: Excel workbooks, uploaded source documents, runtime data and generated
# output all stay on this machine. The authoritative reference files (CLAUDE.md, "Authoritative Files") must be
# present locally; tests that need them skip when they are absent.

# ---- Excel workbooks, anywhere in the tree
*.xlsx
*.xlsm
*.xls

# ---- Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# ---- Frontend
frontend/node_modules/
frontend/dist/
*.tsbuildinfo
npm-debug.log*

# ---- Runtime data: SQLite database, uploaded documents, generated workbooks, logs (MTL_DATA_DIR default)
/MTL_DATA/

# ---- Generated output (the Phase-1 prototype's defective output workbook; SPEC_VALIDATION_REPORT §18.4)
/output/

# ---- Input documents: the tag-scope reference and uploaded engineering sources (real project data)
/input/

# ---- Logs, temporary and Office lock files
*.log
*.tmp
*.bak
~$*

# ---- Secrets and local environment
.env
.env.*
!.env.example

# ---- IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
